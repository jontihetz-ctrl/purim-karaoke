OPENAI_API_KEY=sk-...

# Guardian Net — anonymizes scammer contacts before storing in signals.db
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNAL_SALT=generate-a-random-32-byte-hex-string-here

# Optional: change the Guardian Net local API port (default 4242)
# SIGNALS_API_PORT=4242
